# PostgreSQL used by Dev Buddy
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=change-me
POSTGRESQL_DATABASE=dev_buddy
POSTGRESQL_SSL=false

# Docker Compose host port. The container always listens on port 3000.
DEV_BUDDY_PORT=3000
# Public origin used for redirects behind a reverse proxy. Do not add a trailing slash.
APP_URL=http://localhost:3000
# Use a long random value independent from the database password.
TERMINAL_TICKET_SECRET=replace-with-a-long-random-secret
# Used to encrypt managed credentials. Keep it stable after data is created.
ALIYUN_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Lark SSO (optional). Use "international" for Lark or "china" for Feishu.
LARK_SITE=international
LARK_APP_ID=
LARK_APP_SECRET=
# Must exactly match the redirect URL configured in Lark Developer Console.
LARK_REDIRECT_URI=http://localhost:3000/auth/lark/callback
# Optional: comma-separated tenant_key allowlist. Empty uses the app availability range.
LARK_ALLOWED_TENANT_KEYS=
# Set to false when Lark users must be created by an administrator before first login.
LARK_AUTO_PROVISION=true
# Override only when additional approved scopes are needed.
LARK_SCOPES=auth:user.id:read
